# Per-deployment secrets for the Mazze node + stratum miner.
#
# This file is the canonical source for runtime secrets. Copy it to
# `hydra.secrets.toml` (or let `start-node.sh` / `start-miner.sh` create one for
# you on first run) and fill in real values.
#
# `hydra.secrets.toml` is gitignored — never commit the populated version.
#
# Fields:
# ----------------------------------------------------------------------------
# stratum_secret  64-char hex string. Shared between the node's Stratum server
#                 and any mazze-miner workers that connect to it. The node
#                 stores this as an H256 and authenticates submissions with
#                 keccak(received_string) == stored_h256. Generate with:
#                     openssl rand -hex 32
#                 To rotate: change the value here and restart both node
#                 and miner.
# ----------------------------------------------------------------------------
stratum_secret = ""
